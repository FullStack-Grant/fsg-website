# Sicherheitsheader (T4 2.3), Cloudflare Workers Static Assets.
# frame-src nur für die Terminbuchung auf /kontakt/, geladen erst nach Einwilligung (WEB T12).
# HSTS ohne preload und ohne includeSubDomains, bis alle Subdomains geprüft sind.
/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; frame-src https://calendar.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

# Vorschau-URLs setzt Cloudflare selbst auf X-Robots-Tag: noindex, Vorschau-Builds haben zusätzlich noindex im HTML.
# Die Produktion auf workers.dev bekommt noindex nur über diese Regel; fullstackgrant.de trifft sie nicht.
https://fsg-website.fh-1e8.workers.dev/*
  X-Robots-Tag: noindex

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
