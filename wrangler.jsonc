// Cloudflare Workers Static Assets (WEB T10, T4 Abschnitt 2.1).
// Nur statische Dateien aus dist/, kein Worker-Code. Die Live-Route (fullstackgrant.de)
// wird erst in T13 eingetragen; bis dahin nur Vorschau-URLs. Die Produktion auf workers.dev bleibt aus,
// weil sie sonst ohne noindex als Zweitseite indexierbar wäre.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fsg-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": true,
  // Pflicht für `wrangler preview` (Vorschau je Branch/PR in Workers Builds); leer = Einstellungen wie oben.
  "previews": {},
  "observability": { "enabled": false }
}
