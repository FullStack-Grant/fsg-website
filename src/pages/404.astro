---
import Basis from '../layouts/Basis.astro';
---
<Basis titel="Seite nicht gefunden · FullStack Grant" pfad="/404/" noindex
  beschreibung="Diese Seite gibt es auf fullstackgrant.de nicht (mehr). Von der Startseite aus findest du Leistungen, Förderprogramme, Wissen und den Kontakt.">
  <section class="fehler wrap">
    <span class="label">Fehler 404</span>
    <h1 class="klein">Diese Seite gibt es nicht.</h1>
    <p class="lead">Vielleicht hat sich die Adresse geändert. Von hier geht es weiter:</p>
    <ul>
      <li><a href="/">Startseite</a></li>
      <li><a href="/leistungen/">Leistungen</a></li>
      <li><a href="/foerderung/">Förderung</a></li>
      <li><a href="/kontakt/">Kontakt</a></li>
    </ul>
  </section>
</Basis>

<style>
  .fehler { padding: 72px 0; }
</style>
