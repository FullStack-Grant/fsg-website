---
// Start (Home, Design K3b „Gold auf Ink“, WEB T12; vorher E2). Text: T7 01_Start in der T9-Fassung vom 19.11.2026 (Drive `T9_Rechtspruefung\korrigiert\`),
// freigegeben 18.11.2026 von Felix, korrigiert von T9. Go-live-Rückfall: Kommentare „T9 ab Fassung 1.1“ erst nach
// LEGAL-Meldung zum Einfrieren von AGB 1.1 und Vorlage 1.1 umschalten, auf allen Seiten zugleich.
import Basis from '../layouts/Basis.astro';
import Personenkarte from '../components/Personenkarte.astro';
import Ablauf, { type Ebene, type Ausgeschlossen } from '../components/Ablauf.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import Zustaendigkeiten from '../components/Zustaendigkeiten.astro';
import Schritte from '../components/Schritte.astro';
import Zitat from '../components/Zitat.astro';
import { firma } from '../data/firma';
import { personKnoten } from '../lib/jsonld';

const FINANZAMT = 'Den nachgelagerten Antrag auf Auszahlung der Forschungszulage beim Finanzamt stellt dein Unternehmen bzw. dein Steuerberater.';

const ebenen: Ebene[] = [
  {
    kurz: 'Steuer', titel: 'Steuerliche Förderung', anker: 'steuerliche-foerderung', kosten: 1, zuerst: true,
    text: 'Auf die Forschungszulage besteht ein Rechtsanspruch, wenn die Voraussetzungen erfüllt sind; es gibt keinen Wettbewerb um ein Budget.',
    zeilen: [
      // T9 ab Fassung 1.1: „Den nachgelagerten Antrag auf Auszahlung der Forschungszulage beim Finanzamt stellt dein Unternehmen bzw. dein Steuerberater. Wir liefern die Projektdokumentation dafür.“
      { label: 'Du gibst ab', wert: `Kein Kapital. ${FINANZAMT}` },
      { label: 'Wir bereiten vor', wert: 'Programmcheck, BSFZ-Antrag mit FuE-Argumentation, Vorhabenbeschreibung und Arbeitspaketen, Entwürfe der Antworten auf Rückfragen der BSFZ.' },
      // T9 ab Fassung 1.1: „Compliance: eine nachvollziehbare Projektdokumentation für jedes Wirtschaftsjahr und eine Unterlagenmappe für dich und deinen Steuerberater, im Erfolgshonorar.“
      { label: 'Compliance', wert: 'Hinweise, wie dein Team die Stunden von Anfang an zeitnah und lückenlos je Vorhaben erfasst.', art: 'gold' },
    ],
    tags: ['Bund'],
    detail: { href: '/leistungen/#steuerliche-foerderung', label: 'Im Detail' },
  },
  {
    kurz: 'Zuschuss', titel: 'Zuschüsse und Grants', anker: 'zuschuesse', kosten: 1,
    text: 'Programme von Bund, Ländern und EU, etwa ZIM, KMU-innovativ, Landesprogramme und EIC Accelerator.',
    zeilen: [
      { label: 'Du gibst ab', wert: 'Keine Anteile, dafür Wettbewerb um Budget, Eigenanteil und Nachweispflichten.' },
      { label: 'Wir bereiten vor', wert: 'Auswahl und Kombination, Entwürfe für Skizze und Antrag.' },
      { label: 'Compliance', wert: 'Zwischen- und Verwendungsnachweise und Änderungsanträge, auf Wunsch und nach Aufwand von uns vorbereitet, von dir eingereicht.', art: 'gold' },
    ],
    tags: ['EU', 'Bund', 'Land'],
    detail: { href: '/leistungen/#zuschuesse', label: 'Im Detail' },
  },
  {
    kurz: 'Kredit und Bürgschaft', titel: 'Gefördertes Fremdkapital und Risikoübernahme', anker: 'foerderkredite', kosten: 2,
    text: 'Förderkredite von KfW und Landesförderbanken, Bürgschaften und Haftungsfreistellungen für deine Hausbank.',
    zeilen: [
      { label: 'Du gibst ab', wert: 'Zins und Tilgung, meist zu günstigeren Konditionen als am Markt, dazu gegebenenfalls ein Bürgschaftsentgelt.' },
      { label: 'Wir bereiten vor', wert: 'Einordnung in deinen Finanzierungsplan, Unterlagen für Hausbank und Förderbank.' },
      { label: 'Compliance', wert: 'Nachweise je Programm, auf Wunsch und nach Aufwand von uns vorbereitet.', art: 'gold' },
    ],
    tags: ['EU', 'Bund', 'Land'],
    detail: { href: '/leistungen/#foerderkredite', label: 'Im Detail' },
  },
];

// Beteiligungskapital nicht im Angebot (Felix 23.11.2026), im Ablauf abgesetzt hinter der Trennlinie.
const ausgeschlossen: Ausgeschlossen = {
  kurz: 'Beteiligung',
  titel: 'Staatliches Equity',
  text: 'Staatliches Equity gehört nicht zu unserem Angebot; der Finanzierungsmix endet bei uns davor. Wir vermitteln keine Beteiligungen und empfehlen dir gern kompetente Partner.',
};

// Produktkarte im Hero (Design K3b): Kurzzeilen je Ebene, Texte aus dem Konzept.
const karteUnter = ['Forschungszulage des Bundes', 'Bund, Länder und EU', 'KfW und Landesförderbanken'];
const karteIcon: IconName[] = ['prozent', 'muenzen', 'bank'];

// Über uns: Technologie-Bereiche statt Firmennamen (Felix 24.11.2026); Firmennamen stehen auf /ueber-uns/.
const bereiche = [
  { titel: 'Cloud: Storage und Compute', text: 'Als Director und VP Finance die Forschungszulage für drei Wirtschaftsjahre verantwortet, die BSFZ-Anträge selbst geschrieben und ein Verfahren bis durch die steuerliche Außenprüfung begleitet.' },
  { titel: 'EdTech', text: 'Als Director Finance die BSFZ-Anträge geschrieben und die Forschungszulage verantwortet, dazu LfA-Förderkredite beantragt.' },
  { titel: 'LiDAR-Sensorik für Autonomous Driving', text: 'ZIM-Projekte verantwortet, von Mittelabrufen über Zwischennachweise bis zum Verwendungsnachweis.' },
  { titel: 'Sensorik für Kommunikationsaufklärung', text: 'Preiskalkulation und Projektcontrolling internationaler Großprojekte für öffentliche Auftraggeber, einschließlich Preisprüfungen nach öffentlichem Preisrecht.' },
];
---
<Basis titel="FullStack Grant: Förderberatung für Tech-Startups, Hamburg" pfad="/" vollerGraph
  beschreibung="FullStack Grant ist eine Förderberatung für Tech-Startups: Forschungszulage, Zuschüsse, EU-Grants und Förderkredite, geführt von einem Finance Lead."
  jsonld={[personKnoten()]}>

  <section class="hero auf-ink" aria-labelledby="h-hero">
    <div class="wrap hero-raster">
      <div class="hero-text">
        <h1 id="h-hero"><span class="h1-kicker">Förderberatung für Tech-Startups</span><span class="sr-only">: </span>Förderung, belastbar dokumentiert und auch Jahre später nachvollziehbar.</h1>
        <p class="lead">FullStack Grant ist eine Boutique für Förderberatung aus Hamburg, für Tech-Startups in ganz Deutschland. Wir bereiten für dein Startup die Anträge vor, die zu deiner Finanzierung passen, und begleiten dich auf Wunsch auch nach der Bewilligung. Mit dem Blick eines Finance Leads, der Förderung im Startup selbst verantwortet hat.</p>
        <div class="cta-zeile">
          <a class="btn" href={firma.terminUrl}>Erstgespräch buchen <Icon name="pfeil" /></a>
          <a class="btn btn-linie" href="#finanzierungsmix">Finanzierungsmix ansehen</a>
        </div>
        <ul class="hero-haken">
          <li><Icon name="haken" />Fördercheck kostenlos</li>
          <li><Icon name="haken" />Du entscheidest und reichst selbst ein</li>
        </ul>
      </div>

      <div class="hero-visual">
        <div class="hero-karte">
          <div class="hk-kopf">
            <p class="hk-titel" id="h-hk">Dein Finanzierungsmix</p>
            <p class="hk-sub">In dieser Reihenfolge prüfen wir</p>
          </div>
          <ol class="hk-liste" aria-labelledby="h-hk">
            {ebenen.map((e, i) => (
              <li><a href={`#${e.anker}`}>
                <span class:list={['kachel', i === 0 ? 'kachel-gold' : 'kachel-ton']}><Icon name={karteIcon[i] ?? 'dokument'} /></span>
                <span class="hk-name"><b>{e.titel}</b><small>{karteUnter[i]}</small></span>
                {e.zuerst ? <span class="chip">Auch rückwirkend</span> : <Icon name="pfeil" class="hk-pfeil" />}
              </a></li>
            ))}
          </ol>
          <p class="hk-nicht"><Icon name="verbot" />Nicht bei uns: {ausgeschlossen.titel}</p>
        </div>
        <p class="hero-badge"><span class="kachel kachel-klein"><Icon name="schild" /></span>Auf Wunsch Nachweise über die Laufzeit</p>
      </div>
    </div>
  </section>

  <section class="abschnitt wrap" id="finanzierungsmix" aria-labelledby="h-mix">
    <div class="kopfzeile">
      <p class="eyebrow">Finanzierungsmix</p>
      <h2 id="h-mix">Das ganze Förderportfolio aus über 2.500 Programmen, in einer klaren Reihenfolge</h2>
      <p class="regel">Erst, worauf du Anspruch hast, dann Zuschüsse, dann günstiges Fremdkapital.</p>
      <p class="quelle-zahl">Programme: eigene Programmdatenbank von FullStack Grant, laufend erweitert; gezählt am 26.11.2026.</p>
    </div>
    <Ablauf ebenen={ebenen} ausgeschlossen={ausgeschlossen} />
  </section>

  <section class="abschnitt wrap" id="termin" aria-labelledby="h-termin">
    <div class="cta-panel auf-ink">
      <div class="cta-text">
        <p class="eyebrow">Erstgespräch</p>
        <h2 id="h-termin">Ein Gespräch, danach kennst du deine nächsten Schritte</h2>
        <p class="lead">Im Erstgespräch sprichst du 20 Minuten direkt mit Felix Hinkelmann über Vorhaben und Finanzierung. Danach bekommst du auf Wunsch den Fördercheck: welche Programme passen und in welcher Reihenfolge. Kostenlos und unverbindlich.</p>
        <a class="btn" href={firma.terminUrl}>Erstgespräch buchen <Icon name="pfeil" /></a>
      </div>
      <ul class="cta-liste">
        <li><span class="kachel kachel-gold"><Icon name="uhr" /></span>20 Minuten</li>
        <li><span class="kachel kachel-gold"><Icon name="sprechblase" /></span>Vorhaben und Finanzierung</li>
        <li><span class="kachel kachel-gold"><Icon name="etikett" /></span>Kostenlos und unverbindlich</li>
      </ul>
    </div>
  </section>

  <section class="abschnitt wrap" id="mehr-als-forschungszulage" aria-labelledby="h-mehr">
    <div class="kopfzeile">
      <p class="eyebrow">Mehr als die Forschungszulage</p>
      <h2 id="h-mehr">Förderung als Finanzierungsmix: Zulage, Zuschuss, Kredit</h2>
      <p class="unter">Neben der Forschungszulage gibt es Zuschüsse von Bund, Ländern und EU, Förderkredite mit Bürgschaften. Welche Kombination passt, hängt von Vorhaben, Phase und Finanzierung ab; die Regeln zur Kombination legt jedes Programm selbst fest.</p>
    </div>
    <div class="mix-unten">
      <Zitat rolle="Perspektive" text="Viele Förderberatungen beginnen mit der Forschungszulage, weil sie planbar ist. Wir beginnen mit deiner Finanzierung: Oft bringt ein Zuschuss mit höherer Förderquote mehr, auch wenn er mehr Arbeit macht." />
      <ul class="linkkarte">
        <li><a href="/foerderung/programme/forschungszulage/">Forschungszulage für Startups <Icon name="pfeil" /></a></li>
        <li><a href="/foerderung/programme/zim/">ZIM Förderung <Icon name="pfeil" /></a></li>
        <li><a href="/wissen/artikel/mehr-als-forschungszulage/">Perspektive: Welche Förderung es außer der Forschungszulage gibt <Icon name="pfeil" /></a></li>
      </ul>
    </div>
  </section>

  <section class="abschnitt wrap" id="zustaendigkeiten" aria-labelledby="h-zust">
    <div class="kopfzeile">
      <p class="eyebrow">Zuständigkeiten</p>
      <h2 id="h-zust">Wer was tut. Schwarz auf weiß.</h2>
    </div>
    <Zustaendigkeiten spalten={[
      { titel: 'FullStack Grant', punkte: ['findet die passenden Programme, nicht nur die Forschungszulage', 'entwirft Skizze und Antrag aus deinen Zahlen', 'bereitet auf Wunsch Nachweise über die Laufzeit vor'] },
      { titel: 'Du', punkte: ['entscheidest und reichst selbst ein', 'lieferst Zahlen und Projektwissen', 'prüfst jede Fassung und bestätigst sie in Textform'] },
      { titel: 'Bewusst nicht bei uns', punkte: ['Rechtsberatung', 'Steuerberatung und den nachgelagerten Antrag auf Auszahlung der Forschungszulage beim Finanzamt (dein Unternehmen bzw. dein Steuerberater); für die Einreichung empfehlen wir dir gern kompetente und erfahrene Steuerberater', 'Einreichen in deinem Namen, Garantie einer Bewilligung, staatliches Equity'] },
    ]} />
    <p class="weiter"><a href="/vorgehen/">So läuft eine Förderberatung bei uns <Icon name="pfeil" /></a></p>
  </section>

  <section class="band auf-ink" id="vorgehen" aria-labelledby="h-vorg">
    <div class="wrap">
      <div class="kopfzeile">
        <p class="eyebrow">Vorgehen</p>
        <h2 id="h-vorg">Von der ersten Frage bis zum letzten Nachweis</h2>
      </div>
      <Schritte schritte={[
        { titel: 'Fördercheck', text: 'Welche Programme passen zu Vorhaben, Größe und Finanzierung, in welcher Reihenfolge. Kostenlos und unverbindlich.' },
        { titel: 'Antrag vorbereiten', text: 'Wir entwerfen, du prüfst, bestätigst und reichst ein.' },
        { titel: 'Compliance über die Laufzeit', text: 'Auf Wunsch und nach Aufwand Zwischen- und Verwendungsnachweise, Änderungsanträge und die Durchsicht vor Prüfungen des Fördergebers, ohne Testat.' },
      ]} />
      <ul class="weiter-liste">
        <li><a href="/leistungen/#nach-der-bewilligung">Nach der Bewilligung: Nachweise und Änderungsanträge <Icon name="pfeil" /></a></li>
        <li><a href="/vorgehen/">Vorgehen, Compliance und Governance <Icon name="pfeil" /></a></li>
      </ul>
    </div>
  </section>

  <section class="abschnitt wrap" id="gruender" aria-labelledby="h-gruender">
    <div class="ueber">
      <div class="portraet"><Personenkarte gross /></div>
      <div class="ueber-text">
        <p class="eyebrow">Über uns</p>
        <h2 id="h-gruender">Warum Förderberatung aus der Finance-Leitung kommt</h2>
        <p>Förderung landet am Ende im Liquiditätsplan, im Jahresabschluss und in späteren Prüfungen. Sie ist deshalb eine Frage von Compliance und Governance, nicht nur ein Antrag. Felix Hinkelmann hat sie als Finance Lead selbst verantwortet, in Tech-Unternehmen aus diesen Bereichen:</p>
        <ul class="bereiche">
          {bereiche.map((b) => <li><b>{b.titel}</b><span>{b.text}</span></li>)}
        </ul>
        <Zitat text="Ich habe Förderung als Finance Lead selbst verantwortet. Deshalb behandle ich sie wie Finanzierung: mit Plan, Belegen und Blick auf die Prüfung." />
        <ul class="weiter-liste">
          <li><a href="/ueber-uns/">Mehr über uns <Icon name="pfeil" /></a></li>
          <li><a href="/wissen/artikel/foerderberatung-aus-finance-sicht/">Perspektive: Warum Förderberatung aus der Finance-Leitung kommen sollte <Icon name="pfeil" /></a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="abschnitt wrap" id="verguetung" aria-labelledby="h-verg">
    <div class="kopfzeile">
      <p class="eyebrow">Vergütung</p>
      <h2 id="h-verg">Vergütung je nach Programm, vorab im Angebot</h2>
    </div>
    {/* T9 ab Fassung 1.1: letzter Satz „Was nach der Bewilligung anfällt, rechnen wir nach Aufwand ab, mit Schätzung vorab; bei der Forschungszulage sind Projektdokumentation und Unterlagenmappe enthalten, eine Stundenübersicht und die Begleitung einer Betriebsprüfung laufen nach Stunden.“ */}
    <div class="preise">
      <div class="p-karte p1">
        <p class="p-label">Fördercheck</p>
        <p class="p-wert">Kostenlos</p>
        <p>Der Fördercheck ist kostenlos.</p>
      </div>
      <div class="p-karte p2">
        <p class="p-label">Forschungszulage</p>
        <p class="p-wert">Ohne BSFZ-Bescheinigung kein Honorar</p>
        <p>Bei der Forschungszulage gilt: Bescheinigt die BSFZ dein Vorhaben nicht, zahlst du nichts.</p>
      </div>
      <div class="p-karte p3">
        <p class="p-label">Andere Programme</p>
        <p class="p-wert">Erfolgs&shy;honorar oder festes Honorar</p>
        <p>Bei anderen Programmen: Erfolgshonorar oder festes Honorar, je nach Programm; Einzelheiten im Angebot.</p>
      </div>
    </div>
    <p class="weiter"><a href="/verguetung/">So rechnet FullStack Grant ab <Icon name="pfeil" /></a></p>
  </section>

  <section class="abschnitt wrap" aria-labelledby="h-schluss">
    <div class="schluss auf-ink">
      <h2 id="h-schluss">Welche Förderung passt zu deinem Startup?</h2>
      <p>20 Minuten mit Felix Hinkelmann, kostenlos und unverbindlich.</p>
      <a class="btn" href={firma.terminUrl}>Erstgespräch buchen <Icon name="pfeil" /></a>
    </div>
  </section>

</Basis>

<style>
  /* Hero: Ink-Fläche mit sparsamem Goldglühen hinter der Produktkarte */
  .hero { overflow: clip; border-radius: 0 0 var(--ui-radius-band) var(--ui-radius-band); border: 1px solid var(--ui-ink-rand); border-top: 0;
          background-image: radial-gradient(46% 64% at 79% 58%, var(--ui-glow), rgb(224 154 0 / 0) 72%); }
  .hero-raster { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr); gap: 64px; align-items: center; padding-top: 48px; padding-bottom: 104px; }
  .hero h1 { color: var(--ui-ink-text); margin: 0; }
  .h1-kicker { display: block; margin-bottom: 20px; font: 500 0.8125rem/1.4 var(--fsg-font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ui-ink-akzent); }
  .quelle-zahl { margin: 10px 0 0; font-size: 0.8125rem; color: var(--ui-subtle); }
  .hero .lead { margin: 24px 0 0; font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); max-width: 50ch; }
  .hero .cta-zeile { margin-top: 36px; }
  .hero-haken { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 10px 24px; font-size: 0.9375rem; font-weight: 500; color: var(--ui-ink-lead); }
  .hero-haken li { display: inline-flex; align-items: center; gap: 8px; }
  .hero-haken :global(.ic) { color: var(--ui-ink-akzent); width: 18px; height: 18px; stroke-width: 2.25; }

  .hero-visual { position: relative; padding: 20px 0 36px 28px; }
  /* Goldplatte: gedrehte Fläche hinter der Karte */
  .hero-visual::before { content: ''; position: absolute; inset: 0 -24px 60px 76px; border-radius: 28px; transform: rotate(3deg);
                         background: linear-gradient(140deg, var(--fsg-gold-300), var(--fsg-gold-500) 55%, var(--fsg-gold-600)); }
  .hero-karte { position: relative; background: var(--ui-hk-bg); color: var(--ui-hk-text); border-radius: 24px; box-shadow: var(--ui-schatten-ink); padding: 26px 24px 20px; }
  .hk-kopf { padding: 0 4px 16px; }
  .hk-kopf p { margin: 0; }
  .hk-titel { font-size: 1.125rem; font-weight: 700; letter-spacing: -0.01em; }
  .hk-sub { font-size: 0.875rem; color: var(--ui-hk-subtle); margin-top: 2px !important; }
  .hk-liste { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .hero .hk-liste a { display: flex; align-items: center; gap: 14px; padding: 12px; min-height: 68px; border-radius: var(--ui-radius-zeile); text-decoration: none; color: var(--ui-hk-text); background: var(--ui-hk-row); transition: background-color .15s ease; }
  .hero .hk-liste a:hover { background: var(--ui-hk-row-hover); }
  .hk-liste li:first-child a { box-shadow: inset 0 0 0 1.5px var(--fsg-gold-400); }
  .hero-karte :global(:focus-visible) { outline-color: var(--fsg-gold-600); }
  .hk-name { display: grid; flex: 1; min-width: 0; }
  .hk-name b { font-weight: 600; font-size: 1rem; line-height: 1.3; }
  .hk-name small { font-size: 0.8125rem; color: var(--ui-hk-subtle); line-height: 1.4; }
  .hk-liste :global(.hk-pfeil) { color: var(--ui-hk-subtle); margin-right: 6px; }
  .hk-nicht { display: flex; align-items: center; gap: 10px; margin: 12px 0 0; padding: 12px 14px; border-radius: 14px; font-size: 0.875rem; color: var(--ui-hk-subtle);
              background: repeating-linear-gradient(135deg, transparent 0 7px, var(--ui-hk-row) 7px 14px); box-shadow: inset 0 0 0 1.5px var(--ui-hk-linie); }
  .hero-badge { position: absolute; left: -8px; bottom: 0; display: inline-flex; align-items: center; gap: 10px; margin: 0; padding: 10px 16px 10px 10px; border-radius: var(--ui-radius-zeile);
                background: var(--ui-hk-bg); color: var(--ui-hk-text); box-shadow: var(--ui-schatten-ink); font-size: 0.875rem; font-weight: 600; }

  .kachel { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; flex: none; }
  .kachel-gold { background: var(--fsg-gold-400); color: var(--fsg-ink); }
  .kachel-ton { background: var(--ui-hk-ton); color: var(--ui-hk-ton-icon); }
  .kachel-klein { width: 32px; height: 32px; border-radius: 9px; background: var(--fsg-gold-400); color: var(--fsg-ink); }
  .kachel-klein :global(.ic) { width: 18px; height: 18px; }
  .chip { display: inline-flex; align-items: center; min-height: 26px; padding: 0 10px; border-radius: var(--ui-radius-pille); background: var(--ui-hk-chip-bg); color: var(--ui-hk-chip-text);
          font: 600 0.75rem/1 var(--fsg-font-sans); white-space: nowrap; }

  /* Abschnitte */
  .abschnitt { padding-top: 112px; }
  .kopfzeile { max-width: 760px; margin-bottom: 40px; }
  .kopfzeile h2 { margin: 0; }
  .unter { margin: 14px 0 0; font-size: 1.125rem; color: var(--ui-text-muted); }
  .regel { margin: 16px 0 0; font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem); font-weight: 300; line-height: 1.35; letter-spacing: -0.01em; max-width: 40ch; }
  .regel b { font-weight: 700; }
  .weiter :global(.ic), .linkkarte :global(.ic), .weiter-liste :global(.ic) { width: 18px; height: 18px; }

  /* Mehr als die Forschungszulage: Perspektive und Links */
  .mix-unten { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 16px; align-items: stretch; }
  .mix-unten :global(.zitat) { margin: 0; }
  .linkkarte { list-style: none; margin: 0; padding: 14px 26px; border-radius: var(--ui-radius-karte); background: var(--ui-flaeche-neutral); align-self: stretch; }
