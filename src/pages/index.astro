---
// Start (Home, Design E2). Text: T7 01_Start in der T9-Fassung vom 19.11.2026 (Drive `T9_Rechtspruefung\korrigiert\`),
// freigegeben 18.11.2026 von Felix, korrigiert von T9. Go-live-Rückfall: Kommentare „T9 ab Fassung 1.1“ erst nach
// LEGAL-Meldung zum Einfrieren von AGB 1.1 und Vorlage 1.1 umschalten, auf allen Seiten zugleich.
import Basis from '../layouts/Basis.astro';
import Zeile from '../components/Zeile.astro';
import Personenkarte from '../components/Personenkarte.astro';
import Kapitalsaeule, { type Ebene, type Ausgeschlossen } from '../components/Kapitalsaeule.astro';
import Zustaendigkeiten from '../components/Zustaendigkeiten.astro';
import Schritte from '../components/Schritte.astro';
import Zitat from '../components/Zitat.astro';
import { firma } from '../data/firma';
import { personKnoten } from '../lib/jsonld';

const FINANZAMT = 'Den Antrag beim Finanzamt stellt dein Unternehmen bzw. dein Steuerberater.';

const ebenen: Ebene[] = [
  {
    kurz: 'Steuer', titel: 'Steuerliche Förderung', anker: 'steuerliche-foerderung', kosten: 1, zuerst: true,
    text: 'Auf die Forschungszulage besteht ein Rechtsanspruch, wenn die Voraussetzungen erfüllt sind; es gibt keinen Wettbewerb um ein Budget.',
    zeilen: [
      // T9 ab Fassung 1.1: „Den Antrag beim Finanzamt stellt dein Unternehmen bzw. dein Steuerberater. Wir liefern die Projektdokumentation dafür.“
      { label: 'Du gibst ab', wert: `Nichts an Kapital. ${FINANZAMT}` },
      { label: 'Wir bereiten vor', wert: 'Programmcheck, BSFZ-Antrag mit FuE-Argumentation, Vorhabenbeschreibung und Arbeitspaketen, Entwürfe der Antworten auf Rückfragen der BSFZ.' },
      // T9 ab Fassung 1.1: „Compliance: eine nachvollziehbare Projektdokumentation für jedes Wirtschaftsjahr und eine Unterlagenmappe für dich und deinen Steuerberater, im Erfolgshonorar.“
      { label: 'Compliance', wert: 'Hinweise, wie dein Team die Stunden von Anfang an zeitnah und lückenlos je Vorhaben erfasst.', art: 'gold' },
    ],
    tags: ['Bund'],
  },
  {
    kurz: 'Zuschuss', titel: 'Zuschüsse und Grants', anker: 'zuschuesse', kosten: 1,
    text: 'Programme von Bund, Ländern und EU, etwa ZIM, Landesprogramme, EIC Accelerator und Horizon Europe.',
    zeilen: [
      { label: 'Du gibst ab', wert: 'Keine Anteile, dafür Wettbewerb um Budget, Eigenanteil und Nachweispflichten.' },
      { label: 'Wir bereiten vor', wert: 'Auswahl und Kombination, Entwürfe für Skizze, Antrag und Finanzplan aus deinen Zahlen.' },
      { label: 'Compliance', wert: 'Zwischen- und Verwendungsnachweise und Änderungsanträge, auf Wunsch und nach Aufwand von uns vorbereitet, von dir eingereicht.', art: 'gold' },
    ],
    tags: ['EU', 'Bund', 'Land'],
  },
  {
    kurz: 'Kredit und Bürgschaft', titel: 'Gefördertes Fremdkapital und Risikoübernahme', anker: 'foerderkredite', kosten: 2,
    text: 'Förderkredite von KfW und Landesförderbanken, Bürgschaften und Haftungsfreistellungen für deine Hausbank.',
    zeilen: [
      { label: 'Du gibst ab', wert: 'Zins und Tilgung, meist zu günstigeren Konditionen als am Markt, dazu gegebenenfalls ein Bürgschaftsentgelt.' },
      { label: 'Wir bereiten vor', wert: 'Einordnung in deinen Finanzierungsplan, Unterlagen für Hausbank und Förderbank.' },
      { label: 'Compliance', wert: 'Nachweise je Programm, auf Wunsch und nach Aufwand von uns vorbereitet.', art: 'gold' },
    ],
    tags: ['Bund', 'Land'],
  },
];

// Beteiligungskapital nicht im Angebot (Felix 23.11.2026), sichtbar abgegrenzt unter der Säule, außerhalb des Rahmens.
const ausgeschlossen: Ausgeschlossen = {
  kurz: 'Beteiligung',
  titel: 'Beteiligungskapital und VC-Fundraising',
  text: 'Gehört nicht zu unserem Angebot. Wir vermitteln keine Beteiligungen und haben keinen Investorenkontakt. Der Finanzierungsmix endet bei uns vor den Anteilen.',
};
---
<Basis titel="FullStack Grant: Förderberatung für Tech-Startups, Hamburg" pfad="/" vollerGraph
  beschreibung="FullStack Grant ist eine Förderberatung für Tech-Startups: Forschungszulage, Zuschüsse, EU-Grants und Förderkredite, geführt von einem Finance Lead."
  jsonld={[personKnoten()]}>

  <Zeile hero label={`${firma.name} · ${firma.anschrift.ort}`} ueberschriftId="h-hero">
    <h1 id="h-hero">Förderung, belastbar dokumentiert und auch Jahre später nachvollziehbar.</h1>
    <p class="lead">FullStack Grant ist eine Förderberatung aus Hamburg für Tech-Startups in ganz Deutschland. Wir bereiten für dein Startup die Anträge vor, die zu deiner Finanzierung passen, und begleiten dich auf Wunsch auch nach der Bewilligung. Mit dem Blick eines Finance Leads, der Förderung im Startup selbst verantwortet hat.</p>
    <div class="cta-zeile">
      <a class="btn" href={firma.terminUrl}>Erstgespräch buchen <span class="pfeil" aria-hidden="true">→</span></a>
      <a class="link" href="#finanzierungsmix">Finanzierungsmix ansehen</a>
    </div>
  </Zeile>

  <Zeile label="Finanzierungsmix" id="finanzierungsmix" ueberschriftId="h-mix">
    <h2 id="h-mix">Das ganze Förderportfolio, sortiert nach Kapitalkosten</h2>
    <p class="regel">Erst, worauf du Anspruch hast, dann Zuschüsse, dann günstiges Fremdkapital. <b>Anteile zuletzt.</b></p>
    <Kapitalsaeule ebenen={ebenen} ausgeschlossen={ausgeschlossen} />
    <p class="weiter">Im Detail:
      <a href="/leistungen/#steuerliche-foerderung">Steuerliche Förderung</a> ·
      <a href="/leistungen/#zuschuesse">Zuschüsse und Grants</a> ·
      <a href="/leistungen/#foerderkredite">Förderkredite</a> ·
      <a href="/leistungen/#nach-der-bewilligung">Nach der Bewilligung</a>
    </p>
  </Zeile>

  <Zeile label="Zuständigkeiten" ueberschriftId="h-zust">
    <h2 id="h-zust">Wer was tut. Schwarz auf weiß.</h2>
    <Zustaendigkeiten spalten={[
      { titel: 'FullStack Grant', punkte: ['findet die passenden Programme, nicht nur die Forschungszulage', 'entwirft Antrag und Finanzplan aus deinen Zahlen', 'bereitet auf Wunsch Nachweise über die Laufzeit vor'] },
      { titel: 'Du', punkte: ['entscheidest und reichst selbst ein', 'lieferst Zahlen und Projektwissen', 'prüfst jede Fassung, bestätigst sie in Textform und behältst die Fristen im Blick'] },
      { titel: 'Bewusst nicht bei uns', punkte: ['Rechtsberatung', 'Steuerberatung und Antrag beim Finanzamt zur Forschungszulage (dein Unternehmen bzw. dein Steuerberater)', 'Einreichen in deinem Namen, Garantie einer Bewilligung, Beteiligungskapital und VC-Fundraising'] },
    ]} />
    <p class="weiter"><a href="/vorgehen/">So läuft eine Förderberatung bei uns</a></p>
  </Zeile>

  <Zeile label="Über uns" id="gruender" ueberschriftId="h-gruender">
    <h2 id="h-gruender">Warum Förderberatung aus der Finance-Leitung kommt</h2>
    <Personenkarte />
    <p>Förderung landet am Ende im Liquiditätsplan, im Jahresabschluss und in späteren Prüfungen. Felix Hinkelmann hat sie als Finance Lead selbst verantwortet. Bei der Impossible Cloud GmbH hat er als Director und VP Finance die Forschungszulage für drei Wirtschaftsjahre verantwortet, die BSFZ-Anträge selbst geschrieben und ein Verfahren bis durch die steuerliche Außenprüfung begleitet. Davor hat er bei der Easy-Tutor GmbH als Director Finance die BSFZ-Anträge geschrieben und die Forschungszulage im Unternehmen verantwortet, dazu Mittel aus Start-up Shield Bayern beantragt. Bei der Ibeo Automotive Systems GmbH hat er zuvor ZIM-Projekte in der Abwicklung betreut. Heute bereitet er Anträge vor; steuerliche Prüfungen begleitet dein Steuerberater.</p>
    <p>Jedes Mandat führt er persönlich.</p>
    <Zitat text="Ich habe Förderung als Finance Lead selbst verantwortet. Deshalb behandle ich sie wie Finanzierung: mit Plan, Belegen und Blick auf die Prüfung." />
    <p class="weiter">
      <a href="/ueber-uns/">Mehr über Felix Hinkelmann</a> ·
      <a href="/wissen/artikel/foerderberatung-aus-finance-sicht/">Perspektive: Warum Förderberatung aus der Finance-Leitung kommen sollte</a>
    </p>
  </Zeile>

  <Zeile label="Mehr als die Forschungszulage" id="mehr-als-forschungszulage" ueberschriftId="h-mehr">
    <h2 id="h-mehr">Welche Förderung gibt es außer der Forschungszulage?</h2>
    <p>Neben der Forschungszulage gibt es Zuschüsse von Bund, Ländern und EU, Förderkredite mit Bürgschaften. Welche Kombination passt, hängt von Vorhaben, Phase und Finanzierung ab; die Regeln zur Kombination legt jedes Programm selbst fest.</p>
    <Zitat rolle="Perspektive" text="Viele Förderberatungen beginnen mit der Forschungszulage, weil sie planbar ist. Wir beginnen mit deiner Finanzierung: Oft bringt ein Zuschuss mit höherer Förderquote mehr, auch wenn er mehr Arbeit macht." />
    <p class="weiter">
      <a href="/foerderung/programme/forschungszulage/">Forschungszulage für Startups</a> ·
      <a href="/foerderung/programme/zim/">ZIM Förderung</a> ·
      <a href="/wissen/artikel/mehr-als-forschungszulage/">Perspektive: Warum Förderberatung nicht bei der Forschungszulage aufhören sollte</a>
    </p>
  </Zeile>

  <Zeile label="Vorgehen" id="vorgehen" ueberschriftId="h-vorg">
    <h2 id="h-vorg">Von der ersten Frage bis zum letzten Nachweis</h2>
    <Schritte schritte={[
      { titel: 'Fördercheck', text: 'Welche Programme passen zu Vorhaben, Größe und Finanzierung, in welcher Reihenfolge. Kostenlos und unverbindlich.' },
      { titel: 'Antrag vorbereiten', text: 'Wir entwerfen, du prüfst, bestätigst und reichst ein.' },
      { titel: 'Laufzeit begleiten', text: 'Auf Wunsch und nach Aufwand Zwischen- und Verwendungsnachweise, Änderungsanträge und die Durchsicht vor Prüfungen des Fördergebers, ohne Testat.' },
    ]} />
    <p class="weiter"><a href="/vorgehen/">Vorgehen und Compliance</a></p>
  </Zeile>

  <Zeile label="Vergütung" id="verguetung" ueberschriftId="h-verg">
    <h2 id="h-verg">Vergütung je nach Programm, vorab im Angebot</h2>
    {/* T9 ab Fassung 1.1: letzter Satz „Was nach der Bewilligung anfällt, rechnen wir nach Aufwand ab, mit Schätzung vorab; bei der Forschungszulage sind Projektdokumentation und Unterlagenmappe enthalten, eine Stundenübersicht und die Begleitung einer Betriebsprüfung laufen nach Stunden.“ */}
    <p>Der Fördercheck ist kostenlos. Bei der Forschungszulage gilt: Bescheinigt die BSFZ dein Vorhaben nicht, zahlst du nichts. Bei anderen Programmen: Erfolgshonorar oder festes Honorar, je nach Programm; Einzelheiten im Angebot. Was nach der Bewilligung anfällt, rechnen wir nach Aufwand ab, mit Schätzung vorab.</p>
    <p class="weiter"><a href="/verguetung/">So rechnet FullStack Grant ab</a></p>
  </Zeile>

  <Zeile label="Erstgespräch" id="termin" ueberschriftId="h-termin">
    <h2 id="h-termin">Ein Gespräch, danach kennst du deine nächsten Schritte</h2>
    <p class="lead">Im Erstgespräch sprichst du 20 Minuten direkt mit Felix Hinkelmann über Vorhaben und Finanzierung. Danach bekommst du auf Wunsch den Fördercheck: welche Programme passen und in welcher Reihenfolge. Kostenlos und unverbindlich.</p>
    <a class="btn" href={firma.terminUrl}>Erstgespräch buchen <span class="pfeil" aria-hidden="true">→</span></a>
  </Zeile>
</Basis>

<style>
  .regel { font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem); font-weight: 300; letter-spacing: -0.01em; line-height: 1.35; margin: 0 0 36px; max-width: 40ch; }
  .regel b { font-weight: 700; }
  .weiter { font-size: var(--fsg-text-small); margin-top: 24px; }
</style>
