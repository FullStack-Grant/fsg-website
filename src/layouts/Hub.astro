---
// Hub (Template CollectionPage, T4 3.4): Kartenliste der Unterseiten, aus den Sammlungen erzeugt.
import Basis from './Basis.astro';
import Brotkrumen from '../components/Brotkrumen.astro';
import CtaTermin from '../components/CtaTermin.astro';
import { brotkrumen, sammlungsseite } from '../lib/jsonld';

interface Props {
  titel: string;
  h1: string;
  beschreibung: string;
  einleitung: string;
  pfad: string;
  krumen: { name: string; pfad: string }[];
  gruppen: { titel: string; karten: { titel: string; text: string; pfad: string; label?: string }[] }[];
}
const { titel, h1, beschreibung, einleitung, pfad, krumen, gruppen } = Astro.props;
const info = { pfad, titel, beschreibung };
---
<Basis titel={titel} beschreibung={beschreibung} pfad={pfad} jsonld={[sammlungsseite(info), brotkrumen(krumen)]}>
  <div class="seitenkopf auf-ink">
    <div class="wrap">
      <Brotkrumen teile={krumen} />
      <h1 class="klein">{h1}</h1>
      <p class="lead">{einleitung}</p>
    </div>
  </div>
  <div class="wrap">
    {gruppen.filter((g) => g.karten.length).map((g) => (
      <section>
        <h2>{g.titel}</h2>
        <ul class="karten">
          {g.karten.map((k) => (
            <li>
              {k.label && <span class="label">{k.label}</span>}
              <h3><a href={k.pfad}>{k.titel}</a></h3>
              <p>{k.text}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <CtaTermin />
  </div>
</Basis>

<style>
  section + section { margin-top: 64px; }
  .karten { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .karten li { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 26px; border-radius: var(--ui-radius-karte); background: var(--ui-flaeche-neutral); box-shadow: inset 0 3px 0 transparent; transition: box-shadow .15s ease, background-color .15s ease; }
  .karten li:hover { background: var(--ui-flaeche-gold-1); box-shadow: inset 0 3px 0 var(--ui-goldlinie); }
  h3 { margin: 2px 0 4px; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--ui-goldlinie); }
  .karten p { margin: 0; font-size: var(--fsg-text-small); color: var(--ui-text-muted); }
  @media (max-width: 720px) {
    .karten { grid-template-columns: minmax(0, 1fr); }
    .karten li { padding: 22px 20px; }
  }
</style>
