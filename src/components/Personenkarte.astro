---
// Personenkarte: benannter Gründer mit Porträt, nur im Abschnitt „Über uns“ der Startseite und auf /ueber-uns/
// (Felix 23.11.2026: nicht im Hero). Kein sichtbarer KI-Vermerk mehr (Felix 25.11.2026, siehe data/firma.ts).
// `gross`: Porträt in voller Spaltenbreite (Startseite, Design K3b), sonst kompakt neben Name und Rolle (/ueber-uns/).
import { person } from '../data/firma';
interface Props { text?: string; gross?: boolean }
const { text, gross = false } = Astro.props;
const b = person.bild;
---
<figure class:list={['person', { gross }]}>
  <picture>
    <source srcset={`${b.basis}.avif`} type="image/avif">
    <source srcset={`${b.basis}.webp`} type="image/webp">
    <img class="bild" src={`${b.basis}.jpg`} alt={b.alt} width={b.breite} height={b.hoehe} loading="lazy" decoding="async">
  </picture>
  <figcaption>
    <strong>{person.name}</strong><span>{person.rolle}</span>
    {text && <p>{text}</p>}
  </figcaption>
</figure>

<style>
  .person { display: grid; grid-template-columns: 160px 1fr; gap: 24px; align-items: end; margin: 28px 0; }
  .bild { display: block; width: 160px; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--ui-radius-zeile); }
  strong { display: block; font-size: var(--fsg-text-body-lg); }
  span { display: block; font-size: var(--fsg-text-small); color: var(--ui-text-muted); margin-top: 2px; }
  p { margin: 10px 0 0; font-size: var(--fsg-text-small); color: var(--ui-text-muted); max-width: 60ch; }

  .gross { grid-template-columns: minmax(0, 1fr); gap: 14px; align-items: start; margin: 0; }
  .gross .bild { width: 100%; border-radius: var(--ui-radius-karte); }
  .gross figcaption { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; }
  .gross strong { font-size: 1rem; }
  .gross span { margin-top: 0; }

  @media (max-width: 520px) {
    .person:not(.gross) { grid-template-columns: 112px 1fr; gap: 16px; }
    .person:not(.gross) .bild { width: 112px; }
  }
</style>
