---
// Personenkarte im Hero: benannter Gründer in Firmenstimme (T3 E2, T5). Porträt folgt in T15.
import { person } from '../data/firma';
interface Props { text: string; bild?: { src: string; alt: string } }
const { text, bild } = Astro.props;
---
<div class="person">
  {bild
    ? <img class="bild" src={bild.src} alt={bild.alt} width="88" height="110">
    : <div class="bild platzhalter" role="img" aria-label="Porträt folgt">Porträt folgt</div>}
  <div>
    <strong>{person.name}</strong><span>{person.rolle}</span>
    <p>{text}</p>
  </div>
</div>

<style>
  .person { display: grid; grid-template-columns: 88px 1fr; gap: 16px; align-items: start; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--fsg-color-border); }
  .bild { width: 88px; aspect-ratio: 4 / 5; object-fit: cover; }
  .platzhalter { display: grid; place-items: center; text-align: center; font: 500 9px/1.4 var(--fsg-font-mono); color: var(--fsg-color-text-subtle); padding: 6px; background: var(--fsg-color-bg-subtle); }
  strong { display: block; font-size: var(--fsg-text-body); }
  span { display: block; font-size: var(--fsg-text-small); color: var(--fsg-color-text-muted); margin-top: 2px; }
  p { margin: 10px 0 0; font-size: var(--fsg-text-small); color: var(--fsg-color-text-muted); }
</style>
