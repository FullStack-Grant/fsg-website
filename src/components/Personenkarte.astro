---
// Personenkarte: benannter Gründer mit Porträt, nur im Abschnitt „Über uns“ der Startseite und auf /ueber-uns/
// (Felix 23.11.2026: nicht im Hero). Porträt KI-bearbeitet, deshalb sichtbarer Vermerk (KI-VO Art. 50 Abs. 4).
import { person } from '../data/firma';
interface Props { text?: string }
const { text } = Astro.props;
const b = person.bild;
---
<figure class="person">
  <picture>
    <source srcset={`${b.basis}.avif`} type="image/avif">
    <source srcset={`${b.basis}.webp`} type="image/webp">
    <img class="bild" src={`${b.basis}.jpg`} alt={b.alt} width={b.breite} height={b.hoehe} loading="lazy" decoding="async">
  </picture>
  <figcaption>
    <strong>{person.name}</strong><span>{person.rolle}</span>
    {text && <p>{text}</p>}
    <small>{b.vermerk}</small>
  </figcaption>
</figure>

<style>
  .person { display: grid; grid-template-columns: 160px 1fr; gap: 24px; align-items: end; margin: 28px 0; }
  .bild { display: block; width: 160px; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  strong { display: block; font-size: var(--fsg-text-body-lg); }
  span { display: block; font-size: var(--fsg-text-small); color: var(--fsg-color-text-muted); margin-top: 2px; }
  p { margin: 10px 0 0; font-size: var(--fsg-text-small); color: var(--fsg-color-text-muted); max-width: 60ch; }
  small { display: block; margin-top: 10px; font: 500 var(--fsg-text-label) / 1.4 var(--fsg-font-mono); color: var(--fsg-color-text-muted); }
  @media (max-width: 520px) {
    .person { grid-template-columns: 112px 1fr; gap: 16px; }
    .bild { width: 112px; }
  }
</style>
