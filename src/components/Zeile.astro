---
// Abschnitt der Startseite: kleines Label über dem Inhalt, Inhalt in voller Breite.
// Ohne Nummern und ohne Marginalspalte (Felix 23.11.2026: Spalte nahm zu viel Breite).
interface Props {
  label?: string;
  id?: string;
  ueberschriftId?: string;
  hero?: boolean;
}
const { label, id, ueberschriftId, hero = false } = Astro.props;
---
<section class:list={['zeile', { hero }]} id={id} aria-labelledby={ueberschriftId}>
  {label && <span class="label">{label}</span>}
  <slot />
</section>
