---
// Steckbrief-Box je Programm: jede Zahl mit Stand, Primärquelle verlinkt (T4 3.3, T6 4.3 Nr. 3).
import { datumDe, datumIso } from '../lib/inhalte';
interface Props {
  foerderart: string;
  ebene: string;
  zuletztGeprueft: Date;
  zeilen: { merkmal: string; wert: string; stand?: string }[];
  primaerquelle?: { titel: string; url: string };
}
const { foerderart, ebene, zuletztGeprueft, zeilen, primaerquelle } = Astro.props;
---
<aside class="steckbrief" aria-label="Steckbrief">
  <span class="gold-label">Steckbrief</span>
  <dl>
    <dt>Förderart</dt><dd>{foerderart}</dd>
    <dt>Ebene</dt><dd>{ebene}</dd>
    {zeilen.map((z) => <><dt>{z.merkmal}</dt><dd>{z.wert}{z.stand && <span class="stand"> (Stand: {z.stand})</span>}</dd></>)}
    {primaerquelle && <><dt>Primärquelle</dt><dd><a href={primaerquelle.url} rel="noopener">{primaerquelle.titel}</a></dd></>}
    <dt>Zuletzt geprüft</dt><dd><time datetime={datumIso(zuletztGeprueft)}>{datumDe(zuletztGeprueft)}</time></dd>
  </dl>
</aside>

<style>
  .steckbrief { border: 1px solid var(--fsg-color-border); border-top: 3px solid var(--fsg-color-text); padding: 18px 20px; margin: 0 0 40px; }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 18px; margin: 12px 0 0; font-size: var(--fsg-text-small); }
  dt { font: var(--fsg-weight-label) var(--fsg-text-label) / 1.8 var(--fsg-font-mono); letter-spacing: var(--fsg-tracking-label); text-transform: uppercase; color: var(--fsg-color-text-subtle); }
  dd { margin: 0; overflow-wrap: anywhere; }
  .stand { color: var(--fsg-color-text-muted); }
  @media (max-width: 820px) { dl { grid-template-columns: 1fr; gap: 0; } dd { margin-bottom: 8px; } }
</style>
