---
// Pflichtangaben nach § 5 DDG, nur aus src/data/firma.ts.
import { firma } from '../data/firma';
const a = firma.anschrift;
---
<div class="impressum">
  <h2>Anbieter</h2>
  <dl>
    <dt>Firma</dt><dd>{firma.rechtsname}</dd>
    <dt>Geschäftsanschrift</dt><dd>{a.strasse}<br>{a.plz} {a.ort}<br>{a.land}</dd>
    <dt>Vertreten durch</dt><dd>{firma.geschaeftsfuehrer}, Geschäftsführer</dd>
    <dt>E-Mail</dt><dd><a href={`mailto:${firma.email}`}>{firma.email}</a></dd>
    <dt>Telefon</dt><dd><a href={`tel:${firma.telefon.link}`}>{firma.telefon.anzeige}</a></dd>
  </dl>
  <h2>Registereintrag</h2>
  <dl>
    <dt>Registergericht</dt><dd>{firma.register.gericht}</dd>
    <dt>Registernummer</dt><dd>{firma.register.nummer}</dd>
  </dl>
</div>

<style>
  .impressum h2 { font-size: var(--fsg-text-h3); margin-top: 40px; }
  dl { display: grid; grid-template-columns: 200px 1fr; gap: 8px 24px; }
  dt { color: var(--fsg-color-text-muted); }
  dd { margin: 0; }
  @media (max-width: 820px) { dl { grid-template-columns: 1fr; gap: 0; } dd { margin-bottom: 10px; } }
</style>
