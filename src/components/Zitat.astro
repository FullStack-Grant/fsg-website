---
// Zitat von Felix aus eigener Praxis, als Perspektive gekennzeichnet (T6 4.3 Nr. 5). Nur freigegebene Zitate.
// Design K3b: Goldkarte mit Goldkante links.
import { person } from '../data/firma';
// `rolle` ersetzt die Funktion in der Bildunterschrift, z. B. „Perspektive“ bei wertenden Aussagen (UWG, T9).
interface Props { text: string; rolle?: string }
const { text, rolle = person.rolle } = Astro.props;
---
<figure class="zitat">
  <blockquote><p>„{text}“</p></blockquote>
  <figcaption>{person.name}, {rolle}</figcaption>
</figure>

<style>
  .zitat { margin: 40px 0; padding: 32px 36px; border-radius: var(--ui-radius-karte); background: var(--ui-flaeche-gold-2); box-shadow: inset 4px 0 0 var(--ui-goldlinie); }
  blockquote { margin: 0 0 14px; font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem); font-weight: 400; line-height: 1.5; letter-spacing: -0.01em; }
  blockquote p { margin: 0; max-width: 56ch; }
  figcaption { font-size: var(--fsg-text-small); color: var(--ui-text-muted); }
  @media (max-width: 720px) {
    .zitat { padding: 24px 22px; }
  }
</style>
