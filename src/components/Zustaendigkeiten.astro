---
interface Props { spalten: { titel: string; punkte: string[] }[] }
const { spalten } = Astro.props;
---
<div class="zust">
  {spalten.map((s) => (
    <div><h3>{s.titel}</h3><ul>{s.punkte.map((p) => <li>{p}</li>)}</ul></div>
  ))}
</div>

<style>
  .zust { display: grid; grid-template-columns: repeat(3, 1fr); border-top: var(--rule); }
  .zust > div { padding: 20px 20px 8px 0; }
  .zust > div + div { padding-left: 20px; border-left: 1px solid var(--fsg-color-border); }
  ul { margin: 10px 0 0; padding-left: 18px; font-size: var(--fsg-text-small); }
  li { margin-bottom: 8px; }
  @media (max-width: 820px) {
    .zust { grid-template-columns: 1fr; }
    .zust > div + div { padding-left: 0; border-left: 0; border-top: 1px solid var(--fsg-color-border); }
  }
</style>
