---
// Zuständigkeiten (Design K3b): drei Karten. Erste Spalte (FullStack Grant) Gold getönt mit Goldoberkante,
// zweite (dein Unternehmen) heller getönt, dritte (bewusst nicht bei uns) neutral mit Kreuzen.
import Icon, { type IconName } from './Icon.astro';
interface Props { spalten: { titel: string; punkte: string[] }[] }
const { spalten } = Astro.props;
const ART = ['fsg', 'du', 'nicht'] as const;
const ICON: IconName[] = ['koffer', 'person', 'verbot'];
---
<div class="zust">
  {spalten.map((s, i) => {
    const art = ART[i] ?? 'du';
    return (
      <div class:list={['z-karte', `z-${art}`]}>
        <span class="kachel"><Icon name={ICON[i] ?? 'haken'} /></span>
        <h3>{s.titel}</h3>
        <ul class:list={['liste', { kreuz: art === 'nicht' }]}>
          {s.punkte.map((p) => <li><Icon name={art === 'nicht' ? 'kreuz' : 'haken'} />{p}</li>)}
        </ul>
      </div>
    );
  })}
</div>

<style>
  .zust { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .z-karte { border-radius: var(--ui-radius-karte); padding: 28px 26px 26px; }
  .z-karte h3 { margin: 20px 0 14px; }
  .z-fsg { background: var(--ui-flaeche-gold-2); box-shadow: inset 0 3px 0 var(--ui-goldlinie); }
  .z-du { background: var(--ui-flaeche-gold-1); }
  .z-nicht { background: var(--ui-flaeche-neutral); }
  .kachel { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--ui-karte); color: var(--fsg-color-text); }
  .z-fsg .kachel { background: var(--fsg-gold-400); color: var(--fsg-ink); }
  .z-nicht .kachel { background: transparent; color: var(--ui-subtle); box-shadow: inset 0 0 0 1.5px var(--ui-rand-leer); }
  .liste { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; font-size: 0.9375rem; }
  .liste li { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 10px; align-items: start; }
  .liste :global(.ic) { margin-top: 2px; stroke-width: 2.25; color: var(--ui-gold-text); }
  .kreuz { color: var(--ui-text-muted); }
  .kreuz :global(.ic) { color: var(--ui-subtle); }
  @media (max-width: 1080px) {
    .zust { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 720px) {
    .z-karte { padding: 24px 20px; }
  }
</style>
