---
// Kapitalsäule (Design E2): Ebenen nach Kapitalkosten, goldener Compliance-Rahmen um alle Ebenen. Darunter optional
// eine gestrichelte Ebene außerhalb des Rahmens für das, was nicht bei uns liegt (Felix 23.11.2026: Beteiligungskapital).
// Keine Nummern in den Blöcken (Felix 23.11.2026).
export interface Ebene {
  kurz: string;
  titel: string;
  anker: string;
  kosten: 1 | 2 | 3 | 4;
  text: string;
  zuerst?: boolean;
  zeilen: { label: string; wert: string; art?: 'gold' | 'nicht' }[];
  tags?: string[];
}
export interface Ausgeschlossen { kurz: string; titel: string; text: string; anker?: string }
interface Props { ebenen: Ebene[]; ausgeschlossen?: Ausgeschlossen; rahmenText?: string }
const { ebenen, ausgeschlossen, rahmenText } = Astro.props;
const n = ebenen.length;
---
<div class:list={['saeule', `n${n}`]}>
  {ebenen.map((e, i) => (
    <>
      <div class:list={['blk', `t${i + 1}`, `r${i + 1}`]}>
        <span class="kurz">{e.kurz}</span>
        <span class="meter" role="img" aria-label={`Kapitalkosten ${e.kosten} von 4`}>
          {[1, 2, 3, 4].map((n) => <i class:list={{ an: n <= e.kosten }}></i>)}
        </span>
      </div>
      <div class:list={['erk', `r${i + 1}`, { e1: i === 0 }]} id={e.anker}>
        {e.zuerst && <span class="zuerst">Zuerst prüfen</span>}
        <h3>{e.titel}</h3>
        <p>{e.text}</p>
        <dl>
          {e.zeilen.map((z) => (
            <>
              <dt class:list={{ g: z.art === 'gold', x: z.art === 'nicht' }}>{z.label}</dt>
              <dd class:list={{ x: z.art === 'nicht' }}>{z.art === 'gold' && <span class="gpunkt"></span>}{z.wert}</dd>
            </>
          ))}
        </dl>
        {e.tags && <span class="tags">{e.tags.map((t) => <span class="tag">{t}</span>)}</span>}
      </div>
    </>
  ))}
  {ausgeschlossen && (
    <>
      <div class:list={['blk', 'aus', `r${n + 1}`]}>
        <span class="kurz"><span aria-hidden="true">&#x2715; </span>{ausgeschlossen.kurz}</span>
      </div>
      <div class:list={['erk', 'aus', `r${n + 1}`]} id={ausgeschlossen.anker}>
        <span class="zuerst nicht">Nicht bei uns</span>
        <h3>{ausgeschlossen.titel}</h3>
        <p>{ausgeschlossen.text}</p>
      </div>
    </>
  )}
  <div class="rahmen" aria-hidden="true"><span class="gold-label">Compliance-Rahmen</span></div>
  {rahmenText && <p class="rahmen-text"><span class="gpunkt"></span>{rahmenText}</p>}
</div>

<style>
  .saeule { display: grid; grid-template-columns: 190px minmax(0, 1fr); grid-template-rows: repeat(5, auto) auto; column-gap: 40px; position: relative; margin-top: 28px; }
  .r1 { grid-row: 1; } .r2 { grid-row: 2; } .r3 { grid-row: 3; } .r4 { grid-row: 4; } .r5 { grid-row: 5; }
  .blk { grid-column: 1; display: flex; flex-direction: column; justify-content: space-between; padding: 16px; border-bottom: 3px solid var(--fsg-color-bg); min-height: 150px; font: 600 13px/1.3 var(--fsg-font-mono); letter-spacing: 0.04em; text-transform: uppercase; }
  .erk { grid-column: 2; padding: 16px 0 24px; border-bottom: 1px solid var(--fsg-color-border); scroll-margin-top: 24px; }
  .t1 { background: var(--fsg-color-text); color: var(--fsg-color-bg); font-size: 15px; }
  .t2 { background: color-mix(in srgb, var(--fsg-color-text) 30%, var(--fsg-color-bg)); }
  .t3 { background: color-mix(in srgb, var(--fsg-color-text) 12%, var(--fsg-color-bg)); }
  .t4 { background: var(--fsg-color-bg); outline: 1px dashed color-mix(in srgb, var(--fsg-color-text) 45%, transparent); outline-offset: -1px; color: var(--fsg-color-text-muted); }
  .blk.aus { background: transparent; outline: 1px dashed color-mix(in srgb, var(--fsg-color-text) 45%, transparent); outline-offset: -1px; color: var(--fsg-color-text-muted); margin-top: 36px; min-height: 0; }
  .erk.aus { margin-top: 36px; border-bottom: 0; }
  .erk.aus h3 { color: var(--fsg-color-text-muted); }
  .zuerst.nicht { color: var(--fsg-color-text-muted); }
  .meter { display: inline-flex; gap: 4px; }
  .meter i { width: 11px; height: 11px; border: 1px solid var(--fsg-color-text); display: block; }
  .meter i.an { background: var(--fsg-color-text); }
  .t1 .meter i { border-color: var(--fsg-color-bg); }
  .t1 .meter i.an { background: var(--fsg-color-bg); }
  .zuerst { display: inline-block; margin-bottom: 8px; font: var(--fsg-weight-label) var(--fsg-text-label) / 1 var(--fsg-font-mono); letter-spacing: var(--fsg-tracking-label); text-transform: uppercase; border: 1px solid currentColor; padding: 4px 6px; }
  .erk h3 { margin: 0 0 6px; font-size: var(--fsg-text-h4); }
  .erk.e1 h3 { font-size: var(--fsg-text-h3); }
  .erk p { margin: 0 0 10px; font-size: var(--fsg-text-small); color: var(--fsg-color-text-muted); }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; margin: 12px 0 0; font-size: var(--fsg-text-small); }
  dt { font: var(--fsg-weight-label) var(--fsg-text-label) / 1.7 var(--fsg-font-mono); letter-spacing: var(--fsg-tracking-label); text-transform: uppercase; color: var(--fsg-color-text-subtle); }
  dt.g { color: var(--fsg-color-accent-text); }
  dt.x::before { content: '\2715\00a0'; }
  dd { margin: 0; }
  dd.x { color: var(--fsg-color-text-muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .tag { font: 500 10px/1 var(--fsg-font-mono); letter-spacing: 0.06em; text-transform: uppercase; border: 1px solid var(--fsg-color-border); border-radius: var(--fsg-radius-full); padding: 4px 7px; }
  .rahmen { grid-column: 1; grid-row: 1 / 5; margin: -12px; border: 3px solid var(--fsg-color-accent); border-radius: var(--fsg-radius-sm); pointer-events: none; position: relative; z-index: 1; }
  .rahmen span { position: absolute; top: -11px; left: 12px; background: var(--fsg-color-bg); padding: 0 8px; white-space: nowrap; }
  .n3 .rahmen { grid-row: 1 / 4; }
  .rahmen-text { grid-column: 1 / -1; grid-row: 6; margin-top: 34px; font-size: var(--fsg-text-small); color: var(--fsg-color-text-muted); max-width: 60ch; }
  @media (max-width: 820px) {
    .saeule { grid-template-columns: 96px minmax(0, 1fr); column-gap: 24px; }
    .blk { min-height: 0; padding: 10px; font-size: 10px; }
    .t1 { font-size: 11px; }
    .meter i { width: 8px; height: 8px; }
    .rahmen { margin: -8px; }
    dl { grid-template-columns: 1fr; gap: 0; }
    dd { margin-bottom: 8px; }
  }
</style>
