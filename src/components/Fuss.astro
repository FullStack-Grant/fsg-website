---
// Fuß (Design K3b): neutrale Fläche mit Goldlinie oben, Marke und Slogan, Seiten- und Rechtsnavigation.
import { firma } from '../data/firma';
import { hauptnavigation, rechtsnavigation } from '../data/navigation';
---
<footer class="fuss">
  <div class="wrap raster">
    <div class="marke">
      <img class="lt" src="/logo.svg" alt="FullStack Grant" width="168" height="28" loading="lazy">
      <img class="dk" src="/logo-dunkel.svg" alt="FullStack Grant" width="168" height="28" loading="lazy">
      <p class="slogan">{firma.slogan.map((z) => <span>{z}</span>)}</p>
    </div>
    <nav aria-label="Seiten">
      <p class="titel">Seiten</p>
      {hauptnavigation.map((n) => <a href={n.pfad}>{n.titel}</a>)}
    </nav>
    <nav aria-label="Rechtliches">
      <p class="titel">Rechtliches</p>
      {rechtsnavigation.map((n) => <a href={n.pfad}>{n.titel}</a>)}
      {/* Ohne JavaScript ausgeblendet: dann lädt ohnehin nichts, was eine Einwilligung braucht. */}
      <button type="button" class="einstellungen" id="cookie-einstellungen" data-einstellungen hidden>Cookie-Einstellungen</button>
    </nav>
  </div>
  <div class="wrap zeile">
    <p>{firma.rechtsname}, {firma.anschrift.ort}. Keine Rechts- oder Steuerberatung.</p>
  </div>
</footer>

<style>
  .fuss { margin-top: 112px; background: var(--ui-flaeche-neutral); padding: 64px 0 32px; font-size: 0.9375rem; border-top: 3px solid var(--ui-goldlinie); }
  .raster { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr); gap: 40px; }
  .marke img { height: 28px; width: auto; }
  .slogan { margin: 20px 0 0; font-size: 1.125rem; font-weight: 600; line-height: 1.4; }
  .slogan span { display: block; }
  nav { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
  nav a { text-decoration: none; min-height: 28px; display: inline-flex; align-items: center; color: var(--ui-text-muted); }
  nav a:hover { text-decoration: underline; color: var(--fsg-color-text); }
  .titel { font: 500 0.75rem/1.3 var(--fsg-font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ui-subtle); margin: 0 0 6px; }
  .einstellungen { font: inherit; color: var(--ui-text-muted); background: none; border: 0; padding: 0; min-height: 28px; text-decoration: underline; text-decoration-color: var(--ui-goldlinie); cursor: pointer; }
  .einstellungen[hidden] { display: none; }
  .zeile { margin-top: 48px; }
  .zeile p { margin: 0; padding-top: 24px; border-top: 1px solid var(--ui-linie); color: var(--ui-subtle); font-size: 0.875rem; max-width: none; }
  @media (max-width: 720px) {
    .fuss { margin-top: 80px; padding-top: 48px; }
    .raster { grid-template-columns: 1fr 1fr; gap: 32px 24px; }
    .marke { grid-column: 1 / -1; }
  }
</style>
